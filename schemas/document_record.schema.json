{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/minxplore/schemas/document_record.schema.json",
  "title": "Historical document page-level citation record",
  "description": "One cited page from Internet Archive / SGM / USGS / LoC holdings. Retain metadata, page references and minimal excerpts only; rights verified per item.",
  "type": "object",
  "required": ["document_id", "page_number", "publication_date", "place_name_original",
               "geometry_precision_m", "extraction_confidence", "human_verified",
               "rights_status", "source_citation"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "publication_date": {"type": "string", "minLength": 1},
    "place_name_original": {"type": "string", "minLength": 1},
    "place_name_normalized": {"type": "string"},
    "geometry": {"type": ["object", "null"],
                 "description": "GeoJSON geometry; polygons/approximate areas for uncertain names, never invented exact points"},
    "geometry_precision_m": {"type": "number", "minimum": 0},
    "coordinate_derivation": {"type": "string"},
    "commodity": {"type": "string"},
    "reported_minerals": {"type": "array", "items": {"type": "string"}},
    "host_rock": {"type": "string"},
    "alteration": {"type": "string"},
    "structural_setting": {"type": "string"},
    "assay_value": {"type": ["number", "null"]},
    "assay_unit": {"type": "string"},
    "historical_working_type": {"type": "string"},
    "extraction_confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "human_verified": {"type": "boolean"},
    "rights_status": {"type": "string", "minLength": 1},
    "source_citation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
